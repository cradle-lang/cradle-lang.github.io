{
  "name": "cradle-docusaurus",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "npm run generate-release-notes",
    "start": "docusaurus start",
    "generate-release-notes": "node scripts/generate-release-notes.mjs",
    "generate-release-evidence": "node scripts/generate-release-evidence.mjs",
    "generate-release-prework": "node scripts/generate-release-prework.mjs",
    "generate-release-ai-context": "node scripts/generate-release-ai-context.mjs",
    "capture-release-doctor": "node scripts/run-release-doctor.mjs",
    "test:release-evidence": "node --test scripts/release-evidence.test.mjs",
    "test:release-policy": "node --test scripts/release-policy.test.mjs",
    "test:release-reconciler": "node --test scripts/release-reconciler.test.mjs",
    "test:release-automation": "node --test scripts/release-policy.test.mjs scripts/release-identity.test.mjs scripts/release-evidence.test.mjs scripts/release-prework.test.mjs scripts/release-doctor.test.mjs scripts/run-release-doctor.test.mjs scripts/release-ai-context.test.mjs scripts/release-jit.test.mjs scripts/release-contracts.test.mjs scripts/release-exception.test.mjs scripts/release-escalation-issue.test.mjs scripts/release-review-routing.test.mjs scripts/release-review-packet.test.mjs scripts/release-workflow-config.test.mjs scripts/release-workflow-scenarios.test.mjs scripts/release-operations-metrics.test.mjs scripts/release-provenance.test.mjs scripts/release-reconciler.test.mjs scripts/reconcile-cradlexc-releases.test.mjs",
    "fetch-releases": "node scripts/fetch-releases.mjs",
    "build": "npm run generate-release-notes && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
