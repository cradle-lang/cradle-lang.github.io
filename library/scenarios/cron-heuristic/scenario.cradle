// Cron heuristic comparison lab: four Linux hosts on two networks.
// The cron-host receives T1053.003; baseline-host does not.
// Requires Linux 20.04 images, a running cron service on cron-host,
// privileged Ansible provisioning and the documented cradle-lib content.

metadata() >
    name("CronComparisonLab"),
    eventType("sequence").

instances() >
    instance("cron-host"),
    instance("baseline-host"),
    instance("observer"),
    instance("analyst").

// Experiment host: audit logging plus the upstream Cron heuristic.
instance("cron-host") >
    os("linux", "20.04"),
    config("linux-auditd"),
    heuristic("ttp", "T1053.003").

// Comparison host: same OS and audit configuration, without the heuristic.
instance("baseline-host") >
    os("linux", "20.04"),
    config("linux-auditd").

// Dual-homed observation host. It is not configured as a router.
instance("observer") >
    os("linux", "20.04"),
    config("linux-auditd"),
    config("linux-tcpdump").

instance("analyst") >
    os("linux", "20.04"),
    config("linux-auditd").

networks() >
    network("training"),
    network("management").

network("training") >
    subnet("192.168.70.0/24"),
    endpoint("cron-host", "192.168.70.10"),
    endpoint("baseline-host", "192.168.70.20"),
    endpoint("observer", "192.168.70.30").

network("management") >
    subnet("192.168.71.0/24"),
    endpoint("observer", "192.168.71.10"),
    endpoint("analyst", "192.168.71.20").

// The heuristic acts during provisioning; observations are performed manually.
// No private artifact repository or separate event scripts are required.
events() >
    preEvent(),
    mainEvent(),
    postEvent().
